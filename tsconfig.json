{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "esnext",

		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"declaration": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,

		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		"rootDir": "src/",
		"outDir": "dist/",
		"types": ["node"]
	},
	"include": ["src/"]
}
